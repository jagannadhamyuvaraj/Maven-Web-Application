pipeline {
    agent any
    tools {
        maven 'Maven_3.9.9'
    }
    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }
    stages {
        stage('CheckoutCode')
        {
            steps()
            {
                git branch: "master", url: "https://github.com/jagannadhamyuvaraj/Maven-Web-Application.git"
            }
        }
        stage('BuildPackage')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }
        stage('Docker Login'){
            steps() {
                withCredentials([string(credentialsId: 'DockerHub_PAT', variable: 'DockerHub_PAT')]) {
                    sh 'docker login -u jagannadhamyuvaraj -p ${DockerHub_PAT}'
   
                }

            }
        }
        stage('Builddockerimage')
        {
            steps()
            {
                sh 'docker build -t jagannadhamyuvaraj/login:${buildNumber} .'
            }
        }
        stage('Push Image to DockerHub')
        {
            steps()
            {
                withCredentials([string(credentialsId: 'DockerHub_PAT', variable: 'DockerHub_PAT')]) {
                    sh 'docker login -u jagannadhamyuvaraj -p ${DockerHub_PAT}'
   
                }
                sh 'docker push jagannadhamyuvaraj/login:${buildNumber}'
            }
        }
        stage('Remove the push image from server'){
            steps(){
                sh "docker rmi -f jagannadhamyuvaraj/login:${buildNumber}"
            }
        }
        stage("Deploy image in application server") {
            steps(){
                sshagent(credentials: ['DeploymentServer_SSH']) {
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@54.200.146.134 docker rm -f maven-container || true " 
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@54.200.146.134 docker run -d --name maven-container -p 8080:8080 jagannadhamyuvaraj/login:${buildNumber}" 
    
               }
            }
        }
    }
}