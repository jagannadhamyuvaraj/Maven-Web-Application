pipeline {
    agent any
    tools {
        maven 'Maven_3.9.9'
    }
    stages {
        stage('CheckoutCode')
        {
            steps()
            {
                git branch: "master", url: "https://github.com/jagannadhamyuvaraj/Maven-Web-Application.git"
            }
        }
        stage('BuildPackage')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }
    }
}